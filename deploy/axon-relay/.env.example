# Copy this file to .env (in this directory) and fill in real values
# before running `docker compose up`. See README.md for the full
# walkthrough, including how to generate AXON_RELAY_MATE_KEYS.

# Required. Comma-separated mate_id=base64url-ed25519-public-key pairs,
# one per mate allowed to connect. Get this from running
# `mesh-axon identity` on each mate machine -- it prints the exact
# fragment to paste here. Example shape (not a real key):
#   AXON_RELAY_MATE_KEYS=laptop=AbCdEf0123456789...==
AXON_RELAY_MATE_KEYS=

# Optional. Comma-separated allowed WebSocket origins (e.g. the PWA's
# origin if you're serving it from a fixed domain).
AXON_RELAY_ORIGINS=

# Optional. Both must be set together to enable Web Push wake
# notifications; leave both blank to disable. Generate with, for example:
#   npx web-push generate-vapid-keys
AXON_RELAY_VAPID_PUBLIC_KEY=
AXON_RELAY_VAPID_PRIVATE_KEY=

# Optional rate-limit tunables. Expressed as sustained requests/minute
# (burst vars are a raw count). Leave unset to use axon-relay's built-in
# defaults -- see internal/relay/ratelimit.go.
AXON_RELAY_CONNECT_RATE_LIMIT=
AXON_RELAY_CONNECT_RATE_BURST=
AXON_RELAY_PUSH_RATE_LIMIT=
AXON_RELAY_PUSH_RATE_BURST=
